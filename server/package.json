{
  "name": "variety-shop-server",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "16.17.0",
    "npm": ">=8.15.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc --noEmit",
    "start": "node dist/index.js",
    "compile": "tsc",
    "migrate": "knex migrate:latest --knexfile knexfile.js --env development",
    "seed": "knex seed:run --knexfile knexfile.js --env development",
    "migrate:test": "knex migrate:latest --knexfile knexfile.js --env test",
    "seed:test": "knex seed:run --knexfile knexfile.js --env test",
    "test": "ts-node --transpile-only src/tests/scoring.test.ts && NODE_ENV=test ts-node --transpile-only src/tests/inventory.test.ts && NODE_ENV=test ts-node --transpile-only src/tests/marketing.test.ts && ts-node --transpile-only src/tests/image.test.ts && NODE_ENV=test ts-node --transpile-only src/tests/home.test.ts && NODE_ENV=test ts-node --transpile-only src/tests/analytics.test.ts && NODE_ENV=test ts-node --transpile-only src/tests/auth.test.ts"
  },
  "dependencies": {
    "axios": "1.6.8",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "helmet": "7.1.0",
    "jimp": "0.22.12",
    "jsonwebtoken": "9.0.2",
    "knex": "2.5.1",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.9.8",
    "node-cron": "3.0.3",
    "uuid": "9.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.11",
    "@types/node": "16.18.96",
    "@types/node-cron": "3.0.11",
    "@types/uuid": "9.0.8",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.3.3"
  }
}
