# 复制为仓库根目录或 server/.env
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://127.0.0.1:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shop
DB_PASSWORD=shop123
DB_NAME=variety_shop

JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d

# 无微信凭证时必须为 true，便于本地联调（正式上线设为 false）
MOCK_WX=true
MOCK_PAY=true

WX_APPID=
WX_SECRET=
WX_MCHID=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=http://127.0.0.1:3000/api/pay/wechat/notify

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=店主
