# 复制为仓库根目录或 server/.env
NODE_ENV=development
PORT=3000
# 真机调试请改成电脑的局域网 IP（ipconfig / ifconfig），并与 miniprogram/utils/config.ts 的 FILE_BASE 一致。
# 保持 127.0.0.1 时，开发者工具能出图，手机真机上图片会裂开。
PUBLIC_URL=http://127.0.0.1:3000

# 本地 MySQL 8（默认按 127.0.0.1:3306 / root / root）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=variety_shop
# 单测使用独立库，避免污染开发数据
DB_TEST_NAME=variety_shop_test
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=root

JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d

# 无微信凭证时必须为 true，便于本地联调（正式上线设为 false）
MOCK_WX=true
MOCK_PAY=true

WX_APPID=wx6434c5c04d4b6c6e
WX_SECRET=
WX_MCHID=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=http://127.0.0.1:3000/api/pay/wechat/notify
# 可选。仅当管理端「店铺设置」还没保存提货通知时生效；保存后以管理端为准。
# 模板编号 25930。开发版真机调试用 developer，正式版改为 formal，体验版用 trial。
WX_SUBSCRIBE_PACK_TMPL=ns36Dhhg3tY_GKQ_cR3vSn2e290x_25kDs8Pbz4aS7A
WX_MINIPROGRAM_STATE=developer

# 可选。腾讯位置服务 Key，当前逆地理已改用高德，此项可留空。
TENCENT_MAP_KEY=
# 高德 Web 服务 Key。只放在服务端，不要写进小程序。留空则顾客手动填写地址。
AMAP_WEB_KEY=

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_NAME=店主
