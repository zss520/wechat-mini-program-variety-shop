.search { margin:24rpx; background:#fff; border-radius:999rpx; padding:20rpx 32rpx; color:#999; }
.pause { margin:0 24rpx 16rpx; background:#fff7ed; color:#c2410c; padding:16rpx 24rpx; border-radius:12rpx; }
.banner { height:300rpx; margin:0 24rpx; }
.banner-img { width:100%; height:300rpx; border-radius:16rpx; }
.hint { margin:16rpx 24rpx; color:#8a6a4a; font-size:24rpx; }
.sec { margin:24rpx; }
.h { font-size:32rpx; font-weight:700; margin-bottom:16rpx; }
.hscroll { white-space:nowrap; }
.hitem { display:inline-block; width:280rpx; margin-right:16rpx; vertical-align:top; }
.grid { display:flex; flex-wrap:wrap; justify-content:space-between; }
.gitem { width:48%; margin-bottom:16rpx; }
