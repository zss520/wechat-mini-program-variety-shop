.search-wrap {
  padding: 16rpx 24rpx 8rpx;
}
.banner-wrap {
  margin: 8rpx 24rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
}
.t {
  font-size: 24rpx;
  margin: 8rpx 0 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.deal-sec {
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 72%);
  border: 1rpx solid #ffedd5;
  border-radius: 20rpx;
  padding: 20rpx 20rpx 8rpx;
  margin: 24rpx;
}
.deal-sec .sec-head {
  margin-bottom: 16rpx;
}
.deal-item {
  display: block;
  margin-bottom: 16rpx;
}
.deal-item:last-child {
  margin-bottom: 8rpx;
}
