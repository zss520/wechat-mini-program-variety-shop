<wxs src="../../utils/display.wxs" module="disp" />
<view class="tab-page">
<view class="search-wrap" bindtap="goSearch">
  <t-search placeholder="搜索商品" disabled shape="round" />
</view>

<t-notice-bar
  wx:if="{{settings.pause_order}}"
  visible
  theme="warning"
  content="店主休息中，暂不接单"
  prefix-icon="error-circle"
/>

<view class="banner-wrap" wx:if="{{bannerImages.length}}">
  <t-swiper
    list="{{bannerImages}}"
    autoplay
    height="300rpx"
    navigation="{{nav}}"
    bind:click="onBanner"
  />
</view>

<t-notice-bar
  wx:if="{{shopHint}}"
  visible
  theme="info"
  content="{{shopHint}}"
  prefix-icon="shop"
/>

<view class="sec" wx:if="{{seckills.length}}">
  <view class="sec-head" bindtap="goSeckill">
    <view class="sec-title">{{disp.text(seckillTitle, '限时秒杀')}}</view>
    <view class="sec-more">更多<t-icon name="chevron-right" size="32rpx" /></view>
  </view>
  <scroll-view scroll-x class="hscroll" enhanced show-scrollbar="{{false}}">
    <view class="hitem" wx:for="{{seckills}}" wx:key="id" data-item="{{item}}" bindtap="openSeckill">
      <t-image src="{{disp.thumb(item.goods.thumbUrl, item.goods.coverUrl)}}" width="100%" height="160rpx" mode="aspectFill" shape="round" />
      <view class="t">{{disp.text(item.title)}}</view>
      <view class="price">{{disp.money(item.seckill_price_cent)}}</view>
      <t-count-down wx:if="{{item.remainMs}}" time="{{item.remainMs}}" format="HH:mm:ss" size="small" theme="square" />
    </view>
  </scroll-view>
</view>

<view class="sec group-sec" wx:if="{{groups.length}}">
  <view class="sec-head" bindtap="goGroups">
    <view class="group-head">
      <view class="sec-title">{{disp.text(groupTitle, '拼团')}}</view>
      <t-tag theme="primary" variant="light" size="small">人满发货</t-tag>
    </view>
    <view class="sec-more">全部<t-icon name="chevron-right" size="32rpx" /></view>
  </view>
  <scroll-view scroll-x class="group-scroll" enhanced show-scrollbar="{{false}}">
    <view class="gcard" wx:for="{{groups}}" wx:key="id" data-id="{{item.id}}" bindtap="openGroup">
      <view class="gcard-cover">
        <t-image src="{{disp.cover(item.cover)}}" width="520rpx" height="240rpx" mode="aspectFill" />
        <view class="gcard-badge">{{disp.num(item.required_count)}}人团</view>
        <view class="gcard-cd" wx:if="{{item.remainMs}}">
          <t-count-down time="{{item.remainMs}}" format="HH:mm:ss" size="small" theme="square" />
        </view>
      </view>
      <view class="gcard-body">
        <view class="gcard-title">{{disp.text(item.title)}}</view>
        <view class="gcard-goods" wx:if="{{item.goodsPreview.length}}">
          <view class="gthumb" wx:for="{{item.goodsPreview}}" wx:for-item="g" wx:key="id">
            <t-image src="{{disp.thumb(g.thumbUrl, g.coverUrl)}}" width="72rpx" height="72rpx" shape="round" mode="aspectFill" />
          </view>
          <view class="gmore" wx:if="{{item.goodsMore}}">+{{item.goodsMore}}</view>
        </view>
        <view class="gcard-price">
          <view class="gnow">
            <text class="yen">¥</text>
            <text class="num">{{disp.yuan(item.totalCent)}}</text>
          </view>
          <text class="gorigin" wx:if="{{disp.gt0(item.originCent)}}">{{disp.money(item.originCent)}}</text>
          <text class="gtag">{{item.goodsCount > 1 ? (disp.num(item.goodsCount) + '件组合总价') : '团价'}}</text>
        </view>
        <view class="gcard-prog" wx:if="{{item.hasProgress}}">
          <view class="gtrack">
            <view class="gfill" style="width: {{item.progressPct}}%;"></view>
          </view>
          <view class="gprog-t">已支付 {{disp.num(item.paid)}}/{{disp.num(item.required)}} 人，还差 {{disp.num(item.remain)}} 人</view>
        </view>
        <view class="gcard-wait" wx:else>去开团 · {{disp.num(item.required_count)}}人成团</view>
      </view>
    </view>
    <view class="gcard-end"></view>
  </scroll-view>
</view>

<view class="sec deal-sec" wx:if="{{deals.length}}">
  <view class="sec-head">
    <view class="sec-title">{{disp.text(dealTitle, '特价专区')}}</view>
    <t-tag theme="danger" variant="light" size="small">限时</t-tag>
  </view>
  <view class="deal-item" wx:for="{{deals}}" wx:key="id">
    <goods-card item="{{item}}" layout="row" slot-id="home_deal" position="{{index+1}}" />
  </view>
</view>

<view class="sec" wx:if="{{forYou.length}}">
  <view class="sec-head">
    <view class="sec-title">{{disp.text(forYouTitle, '为你推荐')}}</view>
  </view>
  <view class="goods-grid">
    <view class="goods-grid-item" wx:for="{{forYou}}" wx:key="id">
      <goods-card item="{{item}}" slot-id="for_you" position="{{item.position || index+1}}" />
    </view>
  </view>
</view>

<view class="sec" wx:if="{{recommend.length}}">
  <view class="sec-head">
    <view class="sec-title">{{disp.text(recommendTitle, '本店推荐')}}</view>
  </view>
  <view class="goods-grid">
    <view class="goods-grid-item" wx:for="{{recommend}}" wx:key="id">
      <goods-card item="{{item}}" slot-id="home_recommend" position="{{item.position || index+1}}" />
    </view>
  </view>
</view>

<t-empty wx:if="{{!recommend.length && !deals.length && !forYou.length}}" icon="shop" description="店主正在上架" />
</view>
