<view class="head">当前积分 {{balance}}</view>
<view class="card" wx:for="{{ledger}}" wx:key="id">
  <view>{{item.reason}} {{item.delta > 0 ? '+' : ''}}{{item.delta}}</view>
  <view class="sub">余额 {{item.balance_after}} · {{item.note}}</view>
</view>
<view wx:if="{{!ledger.length}}" class="empty">暂无积分记录</view>
