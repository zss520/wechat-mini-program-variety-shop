.box {
  background: #fff;
  padding: 24rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.big {
  font-size: 48rpx;
}
.origin {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
  font-weight: 400;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}
.sub,
.detail {
  color: #888;
  line-height: 1.6;
}
.rel {
  background: #fff;
  margin-top: 24rpx;
  padding: 24rpx 0;
}
.rel .sec-title {
  padding: 0 24rpx 12rpx;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  box-shadow: 0 -8rpx 24rpx rgba(63, 46, 34, 0.06);
  --td-button-medium-height: 80rpx;
  --td-button-medium-font: 600 28rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular;
  --td-button-medium-padding-horizontal: 24rpx;
}
.cart-entry {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: #fff7ed;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}
.cart-entry-txt {
  font-size: 18rpx;
  color: #c2410c;
  line-height: 1.1;
}
.cart-entry-hover {
  opacity: 0.7;
}
.bar-actions {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bar-actions t-button {
  flex: 1;
  min-width: 0;
}
page {
  padding-top: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}
