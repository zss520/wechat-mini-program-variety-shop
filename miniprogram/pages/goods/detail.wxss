.box {
  background: #fff;
  padding: 24rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.price-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.big {
  font-size: 48rpx;
}
.origin {
  color: #999;
  text-decoration: line-through;
  font-size: 24rpx;
  font-weight: 400;
}
.name {
  font-size: 34rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
}
.sub,
.detail {
  color: #888;
  line-height: 1.6;
}
.rel {
  background: #fff;
  margin-top: 16rpx;
  padding: 24rpx 0 180rpx;
}
.rel .sec-title {
  padding: 0 24rpx 12rpx;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
}
page {
  padding-bottom: 40rpx;
}
