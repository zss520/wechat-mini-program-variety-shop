.hero {
  background: linear-gradient(180deg, #c2410c 0%, #ea580c 100%);
  color: #fff;
  padding: 48rpx 32rpx 40rpx;
}
.hero.has-code {
  padding-bottom: 64rpx;
}
.st {
  font-size: 36rpx;
  font-weight: 700;
}
.code {
  font-size: 64rpx;
  letter-spacing: 12rpx;
  margin: 28rpx 0 12rpx;
  font-weight: 700;
}
.hint {
  opacity: 0.85;
  font-size: 24rpx;
  padding-bottom: 12rpx;
}
.detail-body {
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}
.detail-body.below-code {
  padding-top: 40rpx;
}
.bar {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
t-cell-group {
  display: block;
  margin-top: 24rpx;
}
.detail-body t-cell-group:first-child {
  margin-top: 0;
}
