.hero {
  background: linear-gradient(180deg, #c2410c 0%, #ea580c 100%);
  color: #fff;
  padding: 48rpx 32rpx;
}
.st {
  font-size: 36rpx;
  font-weight: 700;
}
.code {
  font-size: 64rpx;
  letter-spacing: 12rpx;
  margin: 24rpx 0 8rpx;
  font-weight: 700;
}
.hint {
  opacity: 0.85;
  font-size: 24rpx;
}
.bar {
  margin: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
t-cell-group {
  display: block;
  margin-top: 16rpx;
}
