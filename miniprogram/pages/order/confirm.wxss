.seg {
  margin: 24rpx;
}
.seg t-segmented {
  display: block;
  width: 100%;
}
.seg .t-segmented__item,
.seg .t-segmented__item-inner,
.seg .t-segmented__item-label {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.remark {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.safe-bottom {
  margin: 24rpx;
}
.pay-hint {
  margin: 0 24rpx 16rpx;
  font-size: 24rpx;
  color: #8a6a4a;
  text-align: center;
}
t-cell-group {
  display: block;
  margin-top: 24rpx;
}
