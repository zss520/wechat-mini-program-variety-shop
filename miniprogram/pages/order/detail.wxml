<view class="card">
  <view class="st">{{statusText}}</view>
  <view wx:if="{{o.pickup_code && (o.status=='WAIT_PICKUP' || o.status=='PENDING_PACK')}}" class="code">提货码 {{o.pickup_code}}</view>
  <view>单号 {{o.order_no}}</view>
  <view>实付 ¥{{o.pay_amount_cent / 100}}</view>
</view>
<view class="card" wx:for="{{o.items}}" wx:key="id">{{item.name_snapshot}} x{{item.qty}}</view>
<view class="bar">
  <button wx:if="{{o.status=='PENDING_PAY'}}" bindtap="pay">去支付</button>
  <button wx:if="{{o.status=='PENDING_PAY' || o.status=='PENDING_PACK'}}" bindtap="cancel">取消订单</button>
  <button bindtap="call">联系店主</button>
</view>
