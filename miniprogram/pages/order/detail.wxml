<wxs src="../../utils/display.wxs" module="disp" />
<view class="hero {{showCode ? 'has-code' : ''}}">
  <view class="st">{{disp.text(statusText)}}</view>
  <block wx:if="{{showCode}}">
    <view class="code">{{disp.text(o.pickup_code)}}</view>
    <view class="hint">到店出示提货码</view>
  </block>
</view>

<view class="detail-body {{showCode ? 'below-code' : ''}}">
  <t-cell-group theme="card">
    <t-cell title="订单号" note="{{disp.text(o.order_no)}}" />
    <t-cell wx:if="{{o.remark}}" title="备注" note="{{disp.text(o.remark)}}" />
  </t-cell-group>

  <t-cell-group theme="card" title="商品">
    <t-cell
      wx:for="{{o.items}}"
      wx:key="id"
      title="{{disp.text(item.name_snapshot)}}"
      description="x{{disp.num(item.qty)}}　{{disp.money(item.price_cent)}}"
      note="{{disp.money(item.amount_cent)}}"
    />
  </t-cell-group>

  <t-cell-group theme="card" title="优惠与金额">
    <t-cell title="货款" note="{{disp.money(o.goods_amount_cent)}}" />
    <t-cell title="运费" note="{{disp.money(o.freight_cent, '¥0')}}" />
    <t-cell title="优惠券" note="{{disp.couponUsed(o.coupon_name, o.coupon_discount_cent)}}" />
    <t-cell title="积分抵扣" note="{{disp.pointsUsed(o.points_used, o.points_discount_cent)}}" />
    <t-cell wx:if="{{disp.gt0(o.discount_cent)}}" title="优惠合计" note="{{disp.minusMoney(o.discount_cent)}}" />
    <t-cell title="实付" note="{{disp.money(o.pay_amount_cent)}}" />
  </t-cell-group>
</view>

<view class="bar">
  <t-button wx:if="{{o.status=='PENDING_PAY'}}" theme="primary" shape="round" block bind:tap="pay">去支付</t-button>
  <t-button wx:if="{{o.status=='PENDING_PAY' || o.status=='PENDING_PACK'}}" theme="default" variant="outline" shape="round" block bind:tap="cancel">取消订单</t-button>
  <t-button theme="light" shape="round" block bind:tap="call">联系店主</t-button>
</view>
