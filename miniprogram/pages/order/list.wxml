<wxs src="../../utils/display.wxs" module="disp" />
<t-tabs value="{{tab}}" bind:change="onTab" theme="line" space-evenly>
  <t-tab-panel label="全部" value="ALL" />
  <t-tab-panel label="待付款" value="PENDING_PAY" />
  <t-tab-panel label="备货中" value="PENDING_PACK" />
  <t-tab-panel label="待取货" value="WAIT_PICKUP" />
  <t-tab-panel label="已完成" value="COMPLETED" />
</t-tabs>

<view class="order-list">
  <t-cell-group theme="card">
    <t-cell
      wx:for="{{list}}"
      wx:key="id"
      title="{{disp.text(item.order_no)}}"
      description="{{disp.text(item.statusText)}}"
      note="{{disp.money(item.pay_amount_cent)}}"
      hover
      arrow
      data-id="{{item.id}}"
      bind:click="open"
    />
  </t-cell-group>
  <t-empty wx:if="{{!list.length}}" icon="file" description="暂无订单" />
</view>
