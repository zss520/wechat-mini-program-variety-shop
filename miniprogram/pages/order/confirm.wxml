<wxs src="../../utils/display.wxs" module="disp" />
<t-notice-bar
  wx:if="{{paused}}"
  visible
  theme="warning"
  content="店主休息中，暂不接单"
  prefix-icon="error-circle"
/>
<view class="seg">
  <t-segmented value="{{fulfillType}}" options="{{fulfillOptions}}" bind:change="onType" />
</view>

<t-cell-group theme="card">
  <block wx:if="{{fulfillType=='PICKUP'}}">
    <t-cell title="自提地址" description="{{disp.text(pickupAddress)}}" left-icon="shop" />
    <t-cell wx:if="{{pickupHours}}" title="营业时间" note="{{pickupHours}}" left-icon="time" />
    <t-cell wx:if="{{pickupPhone}}" title="联系电话" note="{{pickupPhone}}" left-icon="call" arrow hover bind:click="callShop" />
  </block>
  <t-cell
    wx:else
    title="收货地址"
    description="{{disp.join(preview.address.contact_name, addressText)}}"
    left-icon="location"
    arrow
    hover
    bind:click="goAddr"
  />
</t-cell-group>

<t-cell-group theme="card" title="商品">
  <t-cell
    wx:for="{{preview.items}}"
    wx:key="goodsId"
    title="{{disp.text(item.name)}}"
    note="{{disp.money(item.amountCent)}}"
    description="x{{disp.num(item.qty)}}"
  />
</t-cell-group>

<t-cell-group theme="card">
  <picker wx:if="{{couponOptions.length > 1}}" range="{{couponOptions}}" range-key="label" value="{{couponPickerIndex}}" bindchange="pickCoupon">
    <t-cell
      title="优惠券"
      note="{{couponNote}}"
      left-icon="coupon"
      arrow
    />
  </picker>
  <t-cell wx:else title="优惠券" note="{{couponNote}}" left-icon="coupon" />
  <block wx:if="{{settings.points_enabled !== false}}">
    <t-cell title="积分抵扣" description="{{pointsHint}}" left-icon="gift">
      <t-switch slot="note" value="{{usePoints}}" disabled="{{!canUsePoints}}" bind:change="onPoints" />
    </t-cell>
    <t-cell wx:if="{{usePoints}}" title="使用数量" description="最少100，且为100的倍数">
      <t-stepper
        slot="note"
        value="{{pointsToUse}}"
        min="{{100}}"
        max="{{pointsMax}}"
        step="{{100}}"
        theme="filled"
        integer
        disable-input
        bind:change="onPointsQty"
      />
    </t-cell>
  </block>
  <t-cell title="运费" note="{{disp.money(preview.freightCent, '¥0')}}" description="{{fulfillType=='DELIVERY' ? freightHint : ''}}" />
  <t-cell title="优惠" note="{{disp.minusMoney(preview.discountCent)}}" />
  <t-cell title="应付" note="{{disp.money(preview.payAmountCent, '¥0')}}" />
</t-cell-group>

<view class="remark">
  <t-textarea
    placeholder="备注（选填）"
    value="{{remark}}"
    maxlength="80"
    autosize="{{remarkAutosize}}"
    disable-default-padding="{{true}}"
    confirm-type="done"
    bind:change="remark"
  />
</view>

<view class="pay-hint" wx:if="{{payHint}}">{{payHint}}</view>
<view class="safe-bottom">
  <t-button theme="primary" size="large" shape="round" block disabled="{{paused}}" bind:tap="submit">{{paused ? '店主休息中' : '提交并支付'}}</t-button>
</view>
