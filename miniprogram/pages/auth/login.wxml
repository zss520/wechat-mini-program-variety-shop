<view class="wrap">
  <view class="hero">
    <view class="title">微信授权登录</view>
    <view class="desc">填写昵称和手机号即可成为会员并下单。手机号用于订单联系与售后；也可选用微信一键授权手机号。</view>
  </view>

  <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
    <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar ph">选头像</view>
  </button>
  <view class="hint">点击更换头像</view>

  <view class="field">
    <input
      type="nickname"
      class="nick"
      placeholder="请输入微信昵称"
      value="{{nickname}}"
      maxlength="32"
      bindblur="onNick"
      bindchange="onNick"
    />
  </view>
  <view class="field">
    <input
      type="number"
      class="nick"
      placeholder="{{mockWx ? '手机号（可留空，开发环境将使用测试号）' : '请填写手机号'}}"
      value="{{phone}}"
      maxlength="11"
      bindinput="onPhone"
    />
  </view>

  <view class="agree" bindtap="onAgree">
    <view class="box {{agree ? 'on' : ''}}"></view>
    <view class="agree-txt">
      已阅读并同意
      <text class="link" catchtap="openPrivacy">《隐私政策》</text>
    </view>
  </view>

  <button class="auth-btn" bindtap="onAuthTap" loading="{{submitting}}">微信授权登录</button>

  <button
    wx:if="{{!mockWx}}"
    class="wx-phone-btn"
    open-type="{{agree && nickname ? 'getPhoneNumber' : ''}}"
    bindtap="onWxPhoneTap"
    bindgetphonenumber="onGetPhone"
    loading="{{submitting}}"
  >使用微信手机号</button>

  <view class="foot">未登录不能下单。无需在登录时强行授权微信手机号。</view>
</view>
