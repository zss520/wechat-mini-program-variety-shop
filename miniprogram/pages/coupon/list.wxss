.coupon {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #fff;
  margin: 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #c2410c;
  gap: 16rpx;
}
.left {
  flex: 1;
  min-width: 0;
}
.coupon t-button {
  flex-shrink: 0;
  margin-top: 4rpx;
}
.name {
  font-weight: 700;
}
.sub {
  color: #8a6a4a;
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.45;
}
.meta {
  color: #b89a82;
  font-size: 22rpx;
  margin-top: 6rpx;
  line-height: 1.45;
}
