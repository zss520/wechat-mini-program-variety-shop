.coupon {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  margin: 24rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #c2410c;
  gap: 16rpx;
}
.left {
  flex: 1;
  min-width: 0;
}
.name {
  font-weight: 700;
}
.sub {
  color: #888;
  font-size: 24rpx;
  margin-top: 8rpx;
}
