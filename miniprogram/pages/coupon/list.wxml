<wxs src="../../utils/display.wxs" module="disp" />
<t-tabs value="{{tab}}" bind:change="onTab" theme="line">
  <t-tab-panel label="领券" value="shop" />
  <t-tab-panel label="我的" value="mine" />
</t-tabs>

<view wx:if="{{tab=='shop'}}">
  <view class="coupon" wx:for="{{shop}}" wx:key="id">
    <view class="left">
      <view class="name">{{disp.text(item.name)}}</view>
      <view class="sub">{{disp.text(item.typeText)}} · {{disp.text(item.thresholdText)}}</view>
      <view class="meta">有效开始 {{disp.text(item.startText)}}</view>
      <view class="meta">有效结束 {{disp.text(item.endText)}}</view>
    </view>
    <t-button
      theme="primary"
      size="small"
      shape="round"
      disabled="{{item.remain<=0}}"
      data-id="{{item.id}}"
      bind:tap="claim"
    >{{disp.text(item.btnText)}}</t-button>
  </view>
  <t-empty wx:if="{{!shop.length}}" icon="coupon" description="暂无可领优惠券" />
</view>

<view wx:if="{{tab=='mine'}}">
  <t-tabs value="{{mineTab}}" bind:change="onMineTab" theme="line">
    <t-tab-panel label="未使用" value="UNUSED" />
    <t-tab-panel label="已使用" value="USED" />
    <t-tab-panel label="已过期" value="EXPIRED" />
  </t-tabs>
  <view class="coupon" wx:for="{{mineFiltered}}" wx:key="id">
    <view class="left">
      <view class="name">{{disp.text(item.name)}}</view>
      <view class="sub">{{disp.text(item.typeText)}} · {{disp.text(item.thresholdText)}}</view>
      <view class="meta">有效开始 {{disp.text(item.startText)}}</view>
      <view class="meta">有效结束 {{disp.text(item.endText)}}{{item.sourceText ? ' · ' + item.sourceText : ''}}</view>
    </view>
    <t-tag theme="{{item.displayStatus=='UNUSED' ? 'primary' : 'default'}}" variant="light">{{disp.text(item.statusText)}}</t-tag>
  </view>
  <t-empty wx:if="{{!mineFiltered.length}}" icon="coupon" description="暂无优惠券" />
</view>
