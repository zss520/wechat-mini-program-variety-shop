<view class="tabs">
  <text class="{{tab=='shop'?'on':''}}" data-t="shop" bindtap="setTab">领券</text>
  <text class="{{tab=='mine'?'on':''}}" data-t="mine" bindtap="setTab">我的</text>
</view>
<view class="card" wx:for="{{shop}}" wx:key="id" wx:if="{{tab=='shop'}}">
  <view class="name">{{item.name}}</view>
  <view class="sub">{{item.type=='DISCOUNT' ? '折扣券' : '满减券'}} · 满{{item.min_amount_cent/100}}可用</view>
  <button size="mini" disabled="{{item.remain<=0}}" data-id="{{item.id}}" bindtap="claim">{{item.remain>0?'领取':'已领'}}</button>
</view>
<view class="card" wx:for="{{mine}}" wx:key="id" wx:if="{{tab=='mine'}}">
  <view class="name">{{item.name}} <text class="st">{{item.status}}</text></view>
  <view class="sub">截止 {{item.end_at}}</view>
</view>
<view wx:if="{{tab=='shop' && !shop.length}}" class="empty">暂无可领优惠券</view>
<view wx:if="{{tab=='mine' && !mine.length}}" class="empty">暂无优惠券</view>
