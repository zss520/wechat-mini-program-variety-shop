<t-tabs value="{{tab}}" bind:change="onTab" theme="line">
  <t-tab-panel label="领券" value="shop" />
  <t-tab-panel label="我的" value="mine" />
</t-tabs>

<view wx:if="{{tab=='shop'}}">
  <view class="coupon" wx:for="{{shop}}" wx:key="id">
    <view class="left">
      <view class="name">{{item.name}}</view>
      <view class="sub">{{item.type=='DISCOUNT' ? '折扣券' : '满减券'}} · 满{{item.min_amount_cent/100}}可用</view>
    </view>
    <t-button
      theme="primary"
      size="small"
      shape="round"
      disabled="{{item.remain<=0}}"
      data-id="{{item.id}}"
      bind:tap="claim"
    >{{item.remain>0?'领取':'已领'}}</t-button>
  </view>
  <t-empty wx:if="{{!shop.length}}" icon="coupon" description="暂无可领优惠券" />
</view>

<view wx:if="{{tab=='mine'}}">
  <view class="coupon" wx:for="{{mine}}" wx:key="id">
    <view class="left">
      <view class="name">{{item.name}}</view>
      <view class="sub">截止 {{item.endAtText}}</view>
    </view>
    <t-tag theme="{{item.status=='UNUSED' ? 'primary' : 'default'}}" variant="light">{{item.statusText}}</t-tag>
  </view>
  <t-empty wx:if="{{!mine.length}}" icon="coupon" description="暂无优惠券" />
</view>
