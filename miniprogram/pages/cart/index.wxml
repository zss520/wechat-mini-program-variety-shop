<wxs src="../../utils/display.wxs" module="disp" />
<t-empty wx:if="{{!list.length}}" icon="cart" description="购物车是空的" />

<t-swipe-cell wx:for="{{list}}" wx:key="id">
  <view class="row">
    <t-checkbox
      wx:if="{{!item.invalid}}"
      checked="{{checked.indexOf(item.id)>-1}}"
      data-id="{{item.id}}"
      bind:change="onToggle"
    />
    <t-image src="{{disp.thumb(item.thumbUrl, item.coverUrl)}}" width="140rpx" height="140rpx" shape="round" mode="aspectFill" />
    <view class="info">
      <view class="name">
        {{disp.text(item.name)}}
        <t-tag wx:if="{{item.invalid}}" theme="danger" variant="light" size="small">已失效</t-tag>
      </view>
      <view class="price">{{disp.money(item.priceCent)}}</view>
      <t-stepper
        wx:if="{{!item.invalid}}"
        value="{{item.qty}}"
        min="{{1}}"
        theme="filled"
        data-id="{{item.id}}"
        bind:change="onQtyChange"
      />
    </view>
  </view>
  <view slot="right" class="swipe-del" data-id="{{item.id}}" bindtap="del">删除</view>
</t-swipe-cell>

<view class="upsell" wx:if="{{upsell.suggestions.length}}">
  <view class="uh">凑单：{{disp.text(upsell.target.reason)}} 还差 {{disp.money(upsell.target.remainCent)}}</view>
  <scroll-view scroll-x class="hscroll" enhanced show-scrollbar="{{false}}">
    <view class="hitem" wx:for="{{upsell.suggestions}}" wx:key="id" data-id="{{item.id}}" bindtap="addUpsell">
      <t-image src="{{disp.thumb(item.thumbUrl, item.coverUrl)}}" width="100%" height="140rpx" mode="aspectFill" shape="round" />
      <view class="uname">{{disp.text(item.name)}}</view>
      <view class="price">{{disp.money(item.priceCent)}}</view>
    </view>
  </scroll-view>
</view>

<view class="bar" wx:if="{{list.length}}">
  <t-checkbox checked="{{allChecked}}" bind:change="toggleAll" label="全选" />
  <view class="sum">合计 <text class="price">{{disp.money(total)}}</text></view>
  <t-button theme="primary" size="large" shape="round" bind:tap="settle">去结算</t-button>
</view>
