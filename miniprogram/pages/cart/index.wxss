.need-login {
  padding: 80rpx 48rpx;
  text-align: center;
}
.need-login t-button {
  margin-top: 24rpx;
}
.row {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  gap: 12rpx;
}
.info {
  flex: 1;
  min-width: 0;
}
.name {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.swipe-del {
  width: 140rpx;
  height: 100%;
  background: #d54941;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--tab-bar-space);
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  gap: 16rpx;
}
.sum {
  flex: 1;
  text-align: right;
}
page {
  padding-bottom: calc(var(--tab-bar-space) + 128rpx);
}
.upsell {
  background: #fff;
  margin: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}
.uh {
  font-weight: 700;
  margin-bottom: 12rpx;
}
.uname {
  font-size: 24rpx;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
