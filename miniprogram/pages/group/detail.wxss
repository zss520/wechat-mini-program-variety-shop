page {
  background: #f8f4f0;
}

.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
  background: linear-gradient(160deg, #ea580c 0%, #c2410c 52%, #9a3412 100%);
}

.hero-img {
  display: block;
  width: 100%;
  height: 520rpx;
  --td-image-loading-bg-color: transparent;
  --td-image-loading-color: rgba(255, 255, 255, 0.72);
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(63, 46, 34, 0) 0%, rgba(63, 46, 34, 0.28) 100%);
  pointer-events: none;
}

.hero-badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 1;
  height: 44rpx;
  padding: 0 16rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(194, 65, 12, 0.92);
  border-radius: 8rpx 22rpx 22rpx 8rpx;
  letter-spacing: 1rpx;
}

.sheet {
  position: relative;
  z-index: 2;
  margin: -48rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 24rpx 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(63, 46, 34, 0.08);
}

.sheet::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  height: 6rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: linear-gradient(90deg, #ea580c, #c2410c);
}

.price-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.price-now {
  color: #c2410c;
  font-weight: 700;
  line-height: 1;
  display: flex;
  align-items: flex-end;
}

.price-now .yen {
  font-size: 28rpx;
  line-height: 1.15;
  margin-right: 4rpx;
  font-weight: 700;
}

.bar-now .yen {
  font-size: 22rpx;
  line-height: 1.15;
  margin-right: 2rpx;
  font-weight: 700;
}

.price-now .num {
  font-size: 56rpx;
  letter-spacing: -1rpx;
}

.price-side {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding-bottom: 6rpx;
}

.origin {
  color: #b8a99a;
  font-size: 24rpx;
  text-decoration: line-through;
  font-weight: 400;
}

.save {
  align-self: flex-start;
  color: #c2410c;
  background: #fff7ed;
  font-size: 20rpx;
  line-height: 32rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  font-weight: 600;
}

.title {
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #3f2e22;
}

.goods-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a6a4a;
  line-height: 1.5;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.urge {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  background: #fff7ed;
  border: 1rpx solid #ffedd5;
  border-radius: 16rpx;
  --td-countdown-bg-color: #c2410c;
  --td-error-color: #c2410c;
  --td-countdown-round-color: #ffffff;
}

.urge-copy {
  min-width: 0;
  flex: 1;
}

.urge t-count-down {
  flex-shrink: 0;
}

.urge-k {
  font-size: 26rpx;
  font-weight: 700;
  color: #9a3412;
}

.urge-v {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c2410c;
  opacity: 0.85;
}

.card {
  background: #fff;
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(63, 46, 34, 0.04);
}

.card-h {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.card-t {
  font-size: 30rpx;
  font-weight: 700;
  color: #3f2e22;
}

.card-e {
  font-size: 24rpx;
  color: #c2410c;
  font-weight: 600;
}

.track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #f3e8dc;
  overflow: hidden;
}

.fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #fb923c, #c2410c);
}

.hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a6a4a;
  line-height: 1.5;
}

.slots {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 8rpx;
  margin-top: 20rpx;
}

.slot {
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  --td-avatar-bg-color: #fff7ed;
  --td-avatar-content-color: #c2410c;
  --td-brand-color-light-active: #fff7ed;
}

.slot-empty {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx dashed #e8d5c4;
  background: #faf6f2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.slot-name {
  margin-top: 8rpx;
  max-width: 112rpx;
  font-size: 20rpx;
  color: #8a6a4a;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rule {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.rule.last {
  margin-bottom: 0;
}

.n {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 36rpx;
  text-align: center;
}

.r {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #5c4a3a;
  line-height: 1.55;
}

.page t-cell-group {
  margin: 0 24rpx 24rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(63, 46, 34, 0.06);
  --td-button-medium-height: 80rpx;
  --td-button-medium-font: 600 28rpx / 40rpx PingFang SC, Microsoft YaHei, Arial Regular;
  --td-button-medium-padding-horizontal: 36rpx;
}

.bar-price {
  flex: none;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 80rpx;
}

.bar-now {
  color: #c2410c;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
  display: flex;
  align-items: flex-end;
}

.bar-tip {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8a6a4a;
}

.bar-actions {
  flex: 1;
  min-width: 0;
}

.bar-actions t-button {
  width: 100%;
}

.combo {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3e8dc;
}

.combo:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.combo.on {
  background: #fff7ed;
  margin: 0 -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-radius: 12rpx;
  border-bottom-color: transparent;
}

.combo-info {
  flex: 1;
  min-width: 0;
}

.combo-n {
  font-size: 28rpx;
  font-weight: 600;
  color: #3f2e22;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.combo-p {
  margin-top: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.combo-now {
  color: #c2410c;
  font-weight: 700;
}

.team {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f3e8dc;
}

.team:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.team-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #3f2e22;
}

.team-s {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #c2410c;
}

.log {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3e8dc;
}

.log:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.log-l {
  font-size: 26rpx;
  font-weight: 600;
  color: #3f2e22;
}

.log-r {
  flex: 1;
  text-align: right;
  font-size: 22rpx;
  color: #8a6a4a;
}
