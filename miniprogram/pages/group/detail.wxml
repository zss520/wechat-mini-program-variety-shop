<wxs src="../../utils/display.wxs" module="disp" />

<view class="page" wx:if="{{act}}">
  <view class="hero">
    <t-image class="hero-img" src="{{disp.cover(view.cover)}}" width="100%" height="520rpx" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-badge">限时拼团</view>
  </view>

  <view class="sheet">
    <view class="price-row">
      <view class="price-now">
        <text class="yen">¥</text>
        <text class="num">{{disp.yuan(view.groupCent)}}</text>
      </view>
      <view class="price-side">
        <text class="origin" wx:if="{{disp.gt0(view.originCent)}}">{{disp.money(view.originCent)}}</text>
        <text class="save" wx:if="{{disp.gt0(view.saveCent)}}">立省{{disp.money(view.saveCent)}}</text>
      </view>
    </view>

    <view class="title">{{disp.text(view.title)}}</view>
    <view class="goods-sub" wx:if="{{view.goodsName}}">
      <text>{{disp.text(view.goodsName)}}</text>
      <text wx:if="{{view.goodsSubtitle}}"> · {{disp.text(view.goodsSubtitle)}}</text>
    </view>

    <view class="tags">
      <t-tag theme="primary" variant="light" size="small">{{disp.num(view.required)}}人成团</t-tag>
      <t-tag theme="warning" variant="light" size="small">限购{{disp.num(view.perUserLimit)}}{{view.goodsUnit}}</t-tag>
      <t-tag theme="success" variant="light" size="small">人满发货</t-tag>
      <t-tag wx:if="{{view.multiGoods}}" theme="primary" variant="outline" size="small">{{disp.num(view.goodsList.length)}}件组合总价</t-tag>
    </view>

    <view class="urge">
      <view class="urge-copy">
        <view class="urge-k">{{remainMs ? '距活动结束' : '本场已结束'}}</view>
        <view class="urge-v">满{{disp.num(view.required)}}人成团 · {{disp.num(view.expireHours)}}小时内有效</view>
      </view>
      <t-count-down
        wx:if="{{remainMs}}"
        time="{{remainMs}}"
        format="HH:mm:ss"
        theme="square"
        size="medium"
        split-with-unit="{{true}}"
      />
    </view>
  </view>

  <view class="card" wx:if="{{view.goodsList.length}}">
    <view class="card-h">
      <text class="card-t">团内商品</text>
      <text class="card-e">{{view.multiGoods ? '整单按组合总价结算' : '本场商品'}}</text>
    </view>
    <view class="combo" wx:for="{{view.goodsList}}" wx:key="id" data-id="{{item.id}}" bindtap="goGoods">
      <t-image src="{{disp.thumb(item.thumbUrl, item.coverUrl)}}" width="96rpx" height="96rpx" shape="round" mode="aspectFill" />
      <view class="combo-info">
        <view class="combo-n">{{disp.text(item.name)}}</view>
        <view class="combo-p">
          <text class="combo-now">{{disp.money(item.groupPriceCent)}}</text>
          <text class="origin" wx:if="{{disp.gt0(item.originCent)}}">{{disp.money(item.originCent)}}</text>
        </view>
      </view>
      <t-icon class="combo-go" name="chevron-right" size="36rpx" color="#c5b8aa" />
    </view>
  </view>

  <view class="card">
    <view class="card-h">
      <text class="card-t">成团进度</text>
      <text class="card-e">{{disp.text(view.progressLabel)}}</text>
    </view>
    <view class="track">
      <view class="fill" style="width: {{view.progress}}%;"></view>
    </view>
    <view class="hint">{{disp.text(view.progressHint)}}</view>
    <view class="slots">
      <view class="slot" wx:for="{{view.slots}}" wx:key="id">
        <t-avatar wx:if="{{item.filled && item.avatar}}" image="{{item.avatar}}" size="small" />
        <t-avatar wx:elif="{{item.filled}}" icon="user" size="small" />
        <view wx:else class="slot-empty">
          <t-icon name="usergroup" size="32rpx" color="#d4c4b4" />
        </view>
        <view class="slot-name {{item.leader ? 'lead' : ''}}">{{item.leader ? '团长' : (item.filled ? disp.text(item.name) : '待参团')}}</view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{view.openTeams.length}}">
    <view class="card-h">
      <text class="card-t">可参加的团</text>
      <text class="card-e">{{disp.num(view.openTeams.length)}}个进行中</text>
    </view>
    <view
      class="team {{item.teamId == teamId ? 'on' : ''}}"
      wx:for="{{view.openTeams}}"
      wx:key="teamId"
      data-id="{{item.teamId}}"
      bindtap="pickTeam"
    >
      <view class="team-top">
        <view class="team-copy">
          <view class="team-t">已支付 {{disp.num(item.paidCount)}}/{{disp.num(item.required)}} 人</view>
          <view class="team-s">还差 {{disp.num(item.remain)}} 人成团</view>
        </view>
        <view class="team-go {{item.teamId == teamId ? 'now' : ''}}">{{item.teamId == teamId ? '当前团' : '参加'}}</view>
      </view>
      <view class="team-track">
        <view class="fill" style="width: {{item.progressPct}}%;"></view>
      </view>
    </view>
    <view class="team-open" bindtap="open">没有合适的团？发起新团</view>
  </view>

  <view class="card" wx:if="{{view.logs.length}}">
    <view class="card-h">
      <text class="card-t">进度记录</text>
    </view>
    <view class="log" wx:for="{{view.logs}}" wx:key="id">
      <view class="log-l">{{disp.text(item.label)}}</view>
      <view class="log-r">{{disp.text(item.counts)}} 人<text wx:if="{{item.note}}"> · {{disp.text(item.note)}}</text></view>
    </view>
  </view>

  <view class="card">
    <view class="card-h">
      <text class="card-t">拼团规则</text>
    </view>
    <view class="rule">
      <text class="n">1</text>
      <text class="r">开团或参团后需完成支付，名额才会占用</text>
    </view>
    <view class="rule">
      <text class="n">2</text>
      <text class="r">满 {{disp.num(view.required)}} 人自动成团，按团价结算并发货/备货</text>
    </view>
    <view class="rule">
      <text class="n">3</text>
      <text class="r">成团时限 {{disp.num(view.expireHours)}} 小时，超时未满自动取消并退款</text>
    </view>
    <view class="rule last">
      <text class="n">4</text>
      <text class="r">每人限购 {{disp.num(view.perUserLimit)}} {{view.goodsUnit}}，数量以提交订单为准</text>
    </view>
  </view>
</view>

<t-empty wx:else icon="usergroup" description="活动不存在或已结束" />

<view class="bar" wx:if="{{act}}">
  <view class="bar-price">
    <view class="bar-now">
      <text class="yen">¥</text>
      <text>{{disp.yuan(view.groupCent)}}</text>
    </view>
    <view class="bar-tip">{{view.multiGoods ? '组合总价' : '团价'}}</view>
  </view>
  <view class="bar-actions {{teamId ? 'split' : ''}}">
    <t-button wx:if="{{teamId}}" theme="primary" variant="outline" size="medium" shape="round" disabled="{{!remainMs}}" bind:tap="open">
      发起新团
    </t-button>
    <t-button wx:if="{{teamId}}" class="bar-join" theme="primary" size="medium" shape="round" block disabled="{{!remainMs}}" bind:tap="join">
      {{remainMs ? '参加该团' : '已结束'}}
    </t-button>
    <t-button wx:else theme="primary" size="medium" shape="round" block disabled="{{!remainMs}}" bind:tap="open">
      {{remainMs ? '发起拼团' : '已结束'}}
    </t-button>
  </view>
</view>
