page {
  height: 100%;
  overflow: hidden;
  background: #f5f5f5;
}

/* 绝对铺满导航栏以下、tabBar 以上，避免 height:100% 链失效导致侧栏只跟内容等高 */
.side-bar-wrapper {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  overflow: hidden;
  padding-bottom: var(--tab-bar-space);
  --td-side-bar-width: 220rpx;
  --td-side-bar-height: 100%;
  --td-side-bar-item-height: 96rpx;
  --td-side-bar-border-radius: 16rpx;
  --td-side-bar-bg-color: #f5f5f5;
  --td-side-bar-color: rgba(0, 0, 0, 0.65);
  --td-side-bar-active-color: #c2410c;
  --td-bg-color-container: #ffffff;
}

.t-side-bar {
  flex-shrink: 0;
  height: 100% !important;
}

.t-side-bar-item {
  flex-shrink: 0;
  white-space: nowrap;
}

/* 选中项圆角装饰默认 width:100%，会盖住相邻分类文字 */
.t-side-bar-item__prefix,
.t-side-bar-item__suffix {
  width: 24rpx;
}

.content {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f8f4f0;
}

.sorts {
  flex-shrink: 0;
  padding: 16rpx;
  background: #fff;
}

.goods {
  flex: 1;
  height: 0;
  padding: 16rpx;
  box-sizing: border-box;
}
