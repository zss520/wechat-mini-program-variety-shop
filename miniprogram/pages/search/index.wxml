<view class="page">
  <view class="search-bar">
    <t-search
      value="{{keyword}}"
      placeholder="搜索商品"
      shape="round"
      action="搜索"
      t-class-action="search-action"
      bind:change="onInput"
      bind:submit="onSubmit"
      bind:action-click="search"
    />
  </view>

  <view wx:if="{{searched && !list.length}}" class="empty-card">
    <t-icon name="search" size="72rpx" color="#E2A57A" />
    <view class="empty-title">没有找到相关商品</view>
    <view class="empty-sub">换个关键词试试，或从下面历史记录里选</view>
  </view>

  <view wx:if="{{!list.length}}" class="hist">
    <view class="hist-head">
      <view class="hist-title">
        <t-icon name="time" size="36rpx" color="#C2410C" />
        <text>历史搜索</text>
      </view>
      <view wx:if="{{history.length}}" class="hist-clear" bindtap="clear">
        <t-icon name="delete" size="32rpx" color="#8A6A4A" />
        <text>清空</text>
      </view>
    </view>
    <view wx:if="{{history.length}}" class="tags">
      <t-tag
        wx:for="{{history}}"
        wx:key="*this"
        data-k="{{item}}"
        bind:click="tapHist"
        theme="primary"
        variant="light"
        size="medium"
        shape="round"
      >{{item}}</t-tag>
    </view>
    <view wx:else class="hist-empty">暂无搜索记录，输入商品名称试试</view>
  </view>

  <view wx:if="{{list.length}}" class="result">
    <view class="result-head">
      <view class="result-title">相关商品</view>
      <view class="result-count">{{list.length}} 件</view>
    </view>
    <view class="goods-grid wrap">
      <view class="goods-grid-item" wx:for="{{list}}" wx:key="id">
        <goods-card item="{{item}}" slot-id="search_result" position="{{index+1}}" />
      </view>
    </view>
  </view>
</view>
