.page {
  min-height: 100%;
  background: #f8f4f0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx 8rpx;
  background: #f8f4f0;
  --td-search-height: 64rpx;
  --td-search-bg-color: #ffffff;
  --td-search-padding: 0 22rpx;
  --td-search-icon-size: 36rpx;
  --td-search-icon-color: #c2410c;
  --td-search-placeholder-color: #b89a82;
  --td-search-text-color: #3f2e22;
  --td-search-font: 28rpx / 40rpx PingFangSC, PingFang SC, sans-serif;
  --td-search-clear-icon-size: 36rpx;
  --td-search-clear-icon-color: #c4a58d;
  --td-button-small-height: 64rpx;
  --td-button-small-padding-horizontal: 28rpx;
  --td-button-small-font: 600 26rpx / 40rpx PingFangSC, PingFang SC, sans-serif;
}

.search-field {
  flex: 1;
  min-width: 0;
}

.search-btn {
  flex-shrink: 0;
}

.hist {
  margin: 16rpx 24rpx 0;
  padding: 24rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  --td-tag-default-light-color: #f6efe8;
  --td-tag-default-font-color: #5c4636;
  --td-tag-medium-padding: 10rpx 24rpx;
}

.hist-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hist-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3f2e22;
  line-height: 1.2;
}

.hist-clear {
  padding: 4rpx 0 4rpx 16rpx;
  color: #8a6a4a;
  font-size: 24rpx;
  line-height: 1.2;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.hist-empty {
  padding: 4rpx 0 0;
  color: #b89a82;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 16rpx 24rpx 0;
  padding: 40rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-title {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #3f2e22;
}

.empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a6a4a;
  line-height: 1.5;
}

.result {
  padding: 4rpx 0 32rpx;
}

.result-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 16rpx 24rpx 4rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3f2e22;
}

.result-count {
  font-size: 24rpx;
  color: #8a6a4a;
}

.wrap {
  padding: 12rpx 24rpx 0;
}
