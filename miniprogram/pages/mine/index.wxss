.head {
  background: linear-gradient(180deg, #c2410c 0%, #ea580c 100%);
  color: #fff;
  padding: 48rpx 32rpx 72rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.who {
  flex: 1;
}
.nick {
  font-size: 36rpx;
  font-weight: 700;
}
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.85;
}
.mine-groups {
  margin-top: -32rpx;
  padding: 0 0 24rpx;
}
.mine-block {
  display: block;
}
.mine-block + .mine-block {
  margin-top: 40rpx;
}
.mine-groups t-cell-group {
  display: block;
  margin-top: 0;
}
.shop-info {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.shop-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  flex-shrink: 0;
}
.shop-meta {
  min-width: 0;
  flex: 1;
}
.shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3f2e22;
}
.shop-intro {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8a6a4a;
  line-height: 1.5;
}
