var FALLBACK = '—';

function isEmpty(v) {
  return v === undefined || v === null || v === '';
}

function isSpaceChar(c) {
  return c === ' ' || c === '\t' || c === '\n' || c === '\r';
}

function trim(v) {
  var s = '' + v;
  var start = 0;
  var end = s.length - 1;
  while (start <= end && isSpaceChar(s.charAt(start))) {
    start++;
  }
  while (end >= start && isSpaceChar(s.charAt(end))) {
    end--;
  }
  if (start > end) return '';
  return s.substring(start, end + 1);
}

function toNum(v) {
  if (isEmpty(v) || typeof v === 'boolean') return parseFloat('');
  if (typeof v === 'number') return v;
  return parseFloat('' + v);
}

function isFiniteNum(n) {
  return typeof n === 'number' && !isNaN(n) && isFinite(n);
}

function fallbackOf(fallback) {
  return isEmpty(fallback) ? FALLBACK : fallback;
}

function text(v, fallback) {
  var fb = fallbackOf(fallback);
  if (isEmpty(v)) return fb;
  if (typeof v === 'number' && !isFiniteNum(v)) return fb;
  var s = trim(v);
  if (!s || s === 'undefined' || s === 'null' || s === 'NaN' || s === 'Invalid Date') return fb;
  return s;
}

function num(v, fallback) {
  var fb = fallbackOf(fallback);
  var n = toNum(v);
  if (!isFiniteNum(n)) return fb;
  return '' + n;
}

function hasNum(v) {
  return isFiniteNum(toNum(v));
}

function gt0(v) {
  var n = toNum(v);
  return isFiniteNum(n) && n > 0;
}

function yuan(v, fallback) {
  var fb = fallbackOf(fallback);
  var n = toNum(v);
  if (!isFiniteNum(n)) return fb;
  return '' + n / 100;
}

function money(v, fallback) {
  var fb = fallbackOf(fallback);
  var n = toNum(v);
  if (!isFiniteNum(n)) return fb;
  return '¥' + n / 100;
}

function minusMoney(v, fallback) {
  var fb = isEmpty(fallback) ? '-¥0' : fallback;
  var n = toNum(v);
  if (!isFiniteNum(n)) return fb;
  return '-¥' + n / 100;
}

function signed(v, fallback) {
  var fb = fallbackOf(fallback);
  var n = toNum(v);
  if (!isFiniteNum(n)) return fb;
  return (n > 0 ? '+' : '') + n;
}

function couponNote(name, discountCent) {
  var n = text(name, '未选');
  var c = toNum(discountCent);
  if (!isFiniteNum(c) || c <= 0) return n;
  return n + ' -¥' + c / 100;
}

function couponUsed(name, discountCent) {
  var c = toNum(discountCent);
  var n = text(name, '');
  if (!isFiniteNum(c) || c <= 0) return '未使用';
  if (n) return n + ' -¥' + c / 100;
  return '-¥' + c / 100;
}

function pointsUsed(used, discountCent) {
  var u = toNum(used);
  var c = toNum(discountCent);
  var hasU = isFiniteNum(u) && u > 0;
  var hasC = isFiniteNum(c) && c > 0;
  if (!hasU && !hasC) return '未使用';
  var s = hasU ? '抵扣' + u + '积分' : '积分抵扣';
  if (hasC) return s + ' -¥' + c / 100;
  return s;
}

function join(a, b, fallback) {
  var left = text(a, '');
  var right = text(b, '');
  var s = trim(left + ' ' + right);
  return s || fallbackOf(fallback);
}

var FILE_BASE = 'http://10.0.8.98:3000'; // 与 utils/config.ts 的 FILE_BASE 保持一致

function pathFromAbs(s) {
  var scheme = s.indexOf('://');
  if (scheme < 0) return s;
  var rest = s.substring(scheme + 3);
  var slash = rest.indexOf('/');
  if (slash < 0) return '';
  return rest.substring(slash);
}

function hostPrefix(s, prefix) {
  if (s.indexOf(prefix) !== 0) return false;
  var next = s.substring(prefix.length, prefix.length + 1);
  return next === '' || next === ':' || next === '/';
}

function isLoopback(s) {
  return hostPrefix(s, 'http://127.0.0.1') || hostPrefix(s, 'https://127.0.0.1') || hostPrefix(s, 'http://localhost') || hostPrefix(s, 'https://localhost');
}

function media(v) {
  var s = text(v, '');
  if (!s) return '/assets/tab-home.png';
  if (s.indexOf('wxfile://') === 0 || s.indexOf('http://tmp/') === 0 || s.indexOf('https://tmp/') === 0) return s;
  if (s.indexOf('/assets/') === 0) return s;
  if (isLoopback(s)) return FILE_BASE + pathFromAbs(s);
  if (s.indexOf('/') === 0 && s.indexOf('//') !== 0) return FILE_BASE + s;
  return s;
}

function cover(v) {
  return media(v);
}

function thumb(thumbUrl, coverUrl) {
  var a = text(thumbUrl, '');
  if (a) return media(a);
  return media(coverUrl);
}

function unit(v) {
  var s = text(v, '');
  return s ? '/' + s : '/—';
}

module.exports = {
  text: text,
  num: num,
  hasNum: hasNum,
  gt0: gt0,
  yuan: yuan,
  money: money,
  minusMoney: minusMoney,
  signed: signed,
  couponNote: couponNote,
  couponUsed: couponUsed,
  pointsUsed: pointsUsed,
  join: join,
  cover: cover,
  thumb: thumb,
  unit: unit,
};
