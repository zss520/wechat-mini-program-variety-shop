page {
  --td-brand-color-1: #fff7ed;
  --td-brand-color-2: #ffedd5;
  --td-brand-color-3: #fed7aa;
  --td-brand-color-4: #fdba74;
  --td-brand-color-5: #fb923c;
  --td-brand-color-6: #ea580c;
  --td-brand-color-7: #c2410c;
  --td-brand-color-8: #9a3412;
  --td-brand-color-9: #7c2d12;
  --td-brand-color-10: #431407;
  --td-brand-color: #c2410c;
  --td-brand-color-light: #fff7ed;
  --td-brand-color-focus: #fff7ed;
  --td-brand-color-active: #9a3412;
  --td-brand-color-disabled: #fdba74;
  --td-brand-color-light-active: #ffedd5;
  --td-bg-color-page: #f8f4f0;
  --td-radius-default: 16rpx;
  background: #f8f4f0;
  color: #3f2e22;
  font-size: 28rpx;
  box-sizing: border-box;
  /* 自定义 tabBar 覆盖在页面上：TDesign item 80rpx + 上下 margin 32rpx + 少量空隙，再加安全区 */
  --tab-bar-space: 180rpx;
  --tab-bar-space: calc(128rpx + constant(safe-area-inset-bottom));
  --tab-bar-space: calc(128rpx + env(safe-area-inset-bottom));
}

.price {
  color: var(--td-brand-color);
  font-weight: 700;
}

.sec {
  margin: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 700;
}

.sec-more {
  display: flex;
  align-items: center;
  color: #8a6a4a;
  font-size: 24rpx;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-grid-item {
  width: 48%;
  margin-bottom: 16rpx;
}

.hscroll {
  white-space: nowrap;
}

.hitem {
  display: inline-block;
  width: 240rpx;
  margin-right: 16rpx;
  vertical-align: top;
  background: #fff;
  border-radius: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.tab-page {
  box-sizing: border-box;
  padding-bottom: var(--tab-bar-space);
}
