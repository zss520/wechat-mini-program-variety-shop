{
  "compilerOptions": {
    "strictNullChecks": true,
    "noImplicitAny": false,
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["ES2017"],
    "typeRoots": ["./typings"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "tdesign-miniprogram/*": ["./miniprogram_npm/tdesign-miniprogram/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "miniprogram_npm"]
}
